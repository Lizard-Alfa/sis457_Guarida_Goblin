@model WebGuarida.Models.Producto

@{
    ViewData["Title"] = "Detalles Producto";
}

<h1>Detalles</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IdCategoria)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IdCategoria)
        </dd>
        <dt class = "col-sm-2">Código</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Codigo)</dd>

        <dt class="col-sm-2">Imagen de Juego</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.ImagenUrl)</dd>

        <dt class="col-sm-2">Nombre de Juego</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class = "col-sm-2">Descripción</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class = "col-sm-2">Peso</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.PesoKg)</dd>

        <dt class="col-sm-2">Precio en Usd</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.PrecioCostoUsd)</dd>

        <dt class = "col-sm-2">Precio en Bos</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.PrecioVentaBob)</dd>

        <dt class = "col-sm-2">Stock Actual</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.StockActual)</dd>

        <dt class = "col-sm-2">Stock Minimo</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.StockMinimo)</dd>

        <dt class = "col-sm-2">Usuario Registro</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.UsuarioRegistro)</dd>

        <dt class = "col-sm-2">Descuento Detalle</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.DescuentoDetalle)</dd>

    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver a la Lista</a>
</div>
