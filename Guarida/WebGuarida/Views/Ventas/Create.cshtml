@model IEnumerable<WebGuarida.Models.Venta>

@{
    ViewData["Title"] = "Punto de Ventas";

    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var descPorc = (decimal)(ViewBag.DescuentoPorcentaje ?? 0m);
    var descNombre = (string?)ViewBag.DescuentoNombre;
    var usuario = (string?)ViewBag.Usuario ?? "";
}

<div class="pv-header d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0"><i class="fas fa-cash-register mr-2"></i>Punto de Ventas</h2>

    <div class="text-right small">
        <div><strong>Usuario:</strong> @usuario</div>
        <div><strong>Fecha:</strong> <span id="fechaVentas"></span></div>
    </div>
</div>

<div id="msg" class="alert alert-danger py-2 d-none"></div>

@Html.AntiForgeryToken()

<div class="row">

    <!-- Productos y clientes -->
    <div class="col-lg-7">

        <!-- Cliente -->
        <div class="card shadow mb-3">
            <div class="card-body">
                <div class="row align-items-end">

                    <div class="col-md-4 mb-2">
                        <label class="font-weight-bold">Buscar por CI/NIT</label>
                        <div class="input-group">
                            <input type="text" id="ci" class="form-control" placeholder="CI o NIT" autocomplete="off" maxlength="15"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '')" autofocus />
                        </div>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label class="font-weight-bold">Cliente</label>
                        <input type="text" id="clienteNombre" class="form-control"
                               readonly placeholder="Sin cliente seleccionado" />
                    </div>

                    <div class="col-md-2 mb-2">
                        <button type="button" id="btnNuevoCliente"
                                class="btn btn-success btn-block"
                                data-toggle="modal" data-target="#modalCliente">
                            + Nuevo
                        </button>
                    </div>

                </div>

                <div id="clienteInfo" class="small mt-2"></div>
            </div>
        </div>

        <!-- Productos -->
        <div class="card shadow">
            <div class="card-body">

                <div class="input-group mb-3">
                    <input type="text" id="q" class="form-control"
                           placeholder="Buscar producto por código o nombre"
                           autocomplete="off" />
                    <div class="input-group-append">
                        <button type="button" id="btnLimpiarBusqueda"
                                class="btn btn-secondary">
                            Limpiar
                        </button>
                    </div>
                </div>

                <div class="pv-productos">
                    <div id="productos" class="row"></div>
                </div>

            </div>
        </div>

    </div>

    <!-- Carrito y pago -->
    <div class="col-lg-5">

        <!-- Carrito -->
        <div class="card shadow mb-3">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">Detalle de Ventas</h6>
            </div>

            <div class="card-body p-0">
                <div class="pv-cart">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-right">Precio</th>
                                <th class="text-center">Cant.</th>
                                <th class="text-right">Subtotal</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody id="carrito"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pago -->
        <div class="card shadow mb-3">
            <div class="card-body">

                <label class="font-weight-bold">Observaciones</label>
                <input type="text" id="obs" class="form-control mb-3"
                       placeholder="Sin observaciones" maxlength="500" />

                <div class="d-flex justify-content-between mb-2">
                    <strong>Subtotal</strong>
                    <span id="subtotal">0.00</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <strong>
                        Descuento

                        @if (descPorc > 0)
                        {
                            <span class="badge badge-success">
                                @descPorc.ToString("0.##", inv)%
                                @(string.IsNullOrWhiteSpace(descNombre) ? "" : " · " + descNombre)
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">Sin descuento</span>
                        }
                    </strong>

                    <span id="descuento">0.00</span>
                </div>

                <hr />

                <div class="form-group row align-items-center">
                    <label class="col-5 font-weight-bold">Método de pago</label>
                    <div class="col-7">
                        <select id="metodo" class="form-control">
                            <option value="Efectivo">Efectivo</option>
                            <option value="QR">QR</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Tarjeta">Tarjeta</option>
                        </select>
                    </div>
                </div>

                <div id="bloqueEfectivo">

                    <div class="form-group row align-items-center">
                        <label class="col-5 font-weight-bold">Recibido</label>
                        <div class="col-7">
                            <input type="number" id="recibido" class="form-control"
                                   min="0" step="0.01" placeholder="0.00" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <strong>Cambio</strong>
                        <span id="cambio" class="font-weight-bold">0.00</span>
                    </div>

                </div>

                <div class="pv-total d-flex justify-content-between align-items-center mt-3">
                    <span>Total</span>
                    <strong id="total">0.00</strong>
                </div>

                <div class="row mt-3">
                    <div class="col-6">
                        <button type="button" id="btnRegistrar"
                                class="btn btn-success btn-block">
                            <i class="fas fa-check mr-1"></i> Registrar
                        </button>
                    </div>

                    <div class="col-6">
                        <button type="button" id="btnCancelar"
                                class="btn btn-danger btn-block">
                            <i class="fas fa-times mr-1"></i> Cancelar
                        </button>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-action="Index" class="small">Ver historial de ventas</a>
                </div>

            </div>
        </div>

    </div>
</div>

<!-- Nuevo cliente -->
<div class="modal fade" id="modalCliente" tabindex="-1" role="dialog"
     aria-hidden="true">

    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Nuevo cliente</h5>
                <button type="button" class="close" data-dismiss="modal"
                        aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div id="modalAviso" class="alert alert-warning d-none"></div>

                <div class="form-group">
                    <label>CI/NIT *</label>
                    <input type="text" id="mCi" class="form-control" maxlength="15" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                </div>

                <div class="form-group">
                    <label>Nombres *</label>
                    <input type="text" id="mNombres" class="form-control" maxlength="100" />
                </div>

                <div class="form-group">
                    <label>Apellidos</label>
                    <input type="text" id="mApellidos" class="form-control" maxlength="100" />
                </div>

            </div>

            <div class="modal-footer">
                <button type="button" id="btnUsarExistente"
                        class="btn btn-outline-primary d-none">
                    Usar cliente existente
                </button>

                <button type="button" class="btn btn-secondary"
                        data-dismiss="modal">
                    Cerrar
                </button>

                <button type="button" id="btnGuardarCliente" class="btn btn-success">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {

    <script>
        (function () {

            // Direcciones del sistema
            const KEY = 'VentasState';
            const DESC = @descPorc.ToString(inv);

            const URL_PRODUCTOS = '@Url.Action("BuscarProductos", "Ventas")';
            const URL_CLIENTE = '@Url.Action("BuscarCliente", "Ventas")';
            const URL_NUEVO_CLIENTE = '@Url.Action("CrearClienteRapido", "Ventas")';
            const URL_REGISTRAR = '@Url.Action("Registrar", "Ventas")';
            const URL_STOCK = '@Url.Action("StockProductos", "Ventas")';
            const URL_DETALLE = '@Url.Action("Index", "VentaDetalles")';

            const $ = id => document.getElementById(id);

            const formatter = new Intl.NumberFormat('es-BO', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const money = n => formatter.format(
                Math.round((Number(n) + Number.EPSILON) * 100) / 100
            );

            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[c]));

            const PLACEHOLDER = 'data:image/svg+xml;utf8,' + encodeURIComponent(
                '<svg xmlns="http://www.w3.org/2000/svg" width="300" height="200"><rect width="100%" height="100%" fill="#e9ecef"/><text x="50%" y="50%" fill="#adb5bd" font-size="18" text-anchor="middle" dominant-baseline="middle">Sin imagen</text></svg>'
            );

            function imgSrc(url) {
                if (!url) return PLACEHOLDER;

                return (/^(https?:)?\/\//.test(url) || url.startsWith('/'))
                    ? url : '/' + url;
            }

            // Guardar los datos de la venta
            function estadoVacio() {
                return {
                    cliente: null,
                    ci: '',
                    items: [],
                    metodo: 'Efectivo',
                    recibido: '',
                    obs: '',
                    q: ''
                };
            }

            let state = estadoVacio();

            try {
                const guardado = sessionStorage.getItem(KEY);
                if (guardado) {
                    state = Object.assign(estadoVacio(), JSON.parse(guardado));
                }
            } catch { }

            function guardarEstado() {
                try {
                    sessionStorage.setItem(KEY, JSON.stringify(state));
                } catch { }
            }

            function limpiarEstado() {
                sessionStorage.removeItem(KEY);
                state = estadoVacio();
            }

            // Mostrar mensajes
            let msgTimer;

            function aviso(texto, tipo = 'danger') {
                const m = $('msg');

                m.className = 'alert alert-' + tipo + ' py-2';
                m.textContent = texto;

                clearTimeout(msgTimer);

                msgTimer = setTimeout(() => {
                    m.classList.add('d-none');
                }, 4000);
            }

            // Fecha y hora
            function actualizarFecha() {
                const d = new Date();

                const fecha = d.toLocaleDateString('es-BO');
                const hora = d.toLocaleTimeString('es-BO', {
                    hour: '2-digit',
                    minute: '2-digit',
                    hour12: false
                });

                $('fechaVentas').textContent = fecha + ' ' + hora;
            }

            actualizarFecha();
            setInterval(actualizarFecha, 30000);

            // Calcular los totales
            function totales() {
                const subtotal = state.items.reduce(
                    (total, item) => total + item.precio * item.cantidad, 0
                );

                const descuento = Math.round(
                    (subtotal * DESC / 100 + Number.EPSILON) * 100
                ) / 100;

                return {
                    subtotal,
                    descuento,
                    total: subtotal - descuento
                };
            }

            // Mostrar los productos del carrito
            function renderCarrito() {
                const tb = $('carrito');

                if (state.items.length === 0) {
                    tb.innerHTML = `
                    <tr>
                        <td colspan="5" class="text-center text-muted py-3">
                            Agrega productos desde la lista
                        </td>
                    </tr>`;
                } else {
                    tb.innerHTML = state.items.map((i, idx) => `
                    <tr>
                        <td>
                            <div class="font-weight-bold">${esc(i.nombre)}</div>
                            <small class="text-muted">${esc(i.codigo)}</small>
                        </td>

                        <td class="text-right">${money(i.precio)}</td>

                        <td class="text-center text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    data-act="menos" data-idx="${idx}">−</button>

                            <input type="number"
                                   class="pv-qty form-control form-control-sm d-inline-block text-center"
                                   style="width: 60px;"
                                   min="1"
                                   max="${i.stock}"
                                   value="${i.cantidad}"
                                   data-idx="${idx}"
                                   data-act="set-cantidad" />

                            <button type="button" class="btn btn-sm btn-outline-success"
                                    data-act="mas" data-idx="${idx}">+</button>
                        </td>

                        <td class="text-right">
                            ${money(i.precio * i.cantidad)}
                        </td>

                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-act="del" data-idx="${idx}" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `).join('');
                }

                renderTotales();
            }

            // Actualizar los totales
            function renderTotales() {
                const t = totales();

                $('subtotal').textContent = money(t.subtotal);
                $('descuento').textContent = money(t.descuento);
                $('total').textContent = money(t.total);

                const efectivo = state.metodo === 'Efectivo';

                $('bloqueEfectivo').classList.toggle('d-none', !efectivo);

                if (efectivo) {
                    const recibido = parseFloat(state.recibido) || 0;
                    const cambio = recibido - t.total;

                    $('cambio').textContent = money(cambio > 0 ? cambio : 0);
                }
            }

            // Mostrar el cliente seleccionado
            function renderCliente() {
                $('clienteNombre').value = state.cliente
                    ? state.cliente.nombre : '';

                $('clienteInfo').innerHTML = state.cliente
                    ? '<span class="text-success">Cliente seleccionado</span>'
                    : '';
            }

            // Mostrar los productos disponibles
            function renderProductos(lista) {
                const cont = $('productos');

                if (!lista.length) {
                    cont.innerHTML = `
                                <div class="col-12 text-center text-muted py-4">
                                    No se encontraron productos
                                </div>`;
                    return;
                }

                cont.innerHTML = lista.map(p => {
                    const agotado = p.stock <= 0;

                    return `
                                <div class="col-md-4 col-6 mb-3">
                                    <div class="card h-100 pv-card">

                                        <img src="${esc(imgSrc(p.imagenUrl))}"
                                             class="card-img-top"
                                             alt="Producto"
                                             loading="lazy"
                                             onerror="this.onerror=null;this.src='${PLACEHOLDER}'">

                                        <div class="card-body p-2 d-flex flex-column">

                                            <div class="font-weight-bold small">
                                                ${esc(p.nombre)}
                                            </div>

                                            <small class="text-muted">
                                                ${esc(p.codigo)} · ${esc(p.categoria)}
                                            </small>

                                            <div class="mt-auto pt-2">

                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <strong>Bs ${money(p.precio)}</strong>

                                                    <span class="badge ${agotado ? 'badge-danger' : 'badge-secondary'}">
                                                        Stock: ${p.stock}
                                                    </span>
                                                </div>

                                                <button type="button"
                                                        class="btn btn-sm btn-primary btn-block"
                                                        data-add='${esc(JSON.stringify({
                                                         id: p.id,
                                                        codigo: p.codigo,
                                                        nombre: p.nombre,
                                                        precio: p.precio,
                                                        stock: p.stock
                                                        }))}'
                                                        ${agotado ? 'disabled' : ''}>
                                                    Agregar
                                                </button>

                                            </div>
                                       </div>
                                    </div>
                                </div>`;
                }).join('');
            }

            // Buscar productos
            let reqProductos = 0;

            async function cargarProductos() {
                const mi = ++reqProductos;
                const cont = $('productos');

                cont.innerHTML = `
                            <div class="col-12 text-center text-muted py-4">
                                Cargando productos...
                            </div>`;

                try {
                    const r = await fetch(
                        URL_PRODUCTOS + '?q=' + encodeURIComponent($('q').value.trim()),
                        { cache: 'no-store' }
                    );

                    if (!r.ok) throw new Error();

                    const lista = await r.json();

                    if (mi === reqProductos) {
                        renderProductos(lista);
                    }

                } catch {
                    if (mi === reqProductos) {
                        cont.innerHTML = `
                                    <div class="col-12 text-center text-danger py-3">
                                        No se pudieron cargar los productos.
                                    </div>`;
                    }
                }
            }

            // Actualizar el stock de los productos del carrito
            async function sincronizarCarrito() {
                if (!state.items.length) return;

                try {
                    const qs = state.items.map(i =>
                        'ids=' + encodeURIComponent(i.id)
                    ).join('&');

                    const r = await fetch(URL_STOCK + '?' + qs, {
                        cache: 'no-store'
                    });

                    if (!r.ok) return;

                    const datos = await r.json();
                    const mapa = new Map(datos.map(d => [d.id, d]));

                    let cambio = false;

                    state.items = state.items.filter(i => {
                        const d = mapa.get(i.id);

                        if (!d || !d.activo || d.stock <= 0) {
                            cambio = true;
                            return false;
                        }

                        i.stock = d.stock;
                        i.precio = Number(d.precio);

                        if (i.cantidad > d.stock) {
                            i.cantidad = d.stock;
                            cambio = true;
                        }

                        return true;
                    });

                    guardarEstado();
                    renderCarrito();

                    if (cambio) {
                        aviso('Se actualizaron las cantidades según el stock disponible.', 'warning');
                    }

                } catch { }
            }

            function refrescar() {
                cargarProductos();
                sincronizarCarrito();
            }

           
                function agregar(p, cantidad = 1) {
                    const existente = state.items.find(i => i.id === p.id);

                    
                    cantidad = parseInt(cantidad, 10);
                    if (isNaN(cantidad) || cantidad < 1) cantidad = 1;

                    if (existente) {
                      
                        const nuevaCantidad = existente.cantidad + cantidad;

                        if (nuevaCantidad > p.stock) {
                            aviso(`Stock insuficiente. Disponible: ${p.stock}.`, 'warning');
                            existente.cantidad = p.stock;
                        } else {
                            existente.cantidad = nuevaCantidad;
                        }

                        existente.stock = p.stock;

                    } else {
                
                        const cantFinal = cantidad > p.stock ? p.stock : cantidad;

                        if (cantidad > p.stock) {
                            aviso(`Stock insuficiente. Se agregaron ${p.stock}.`, 'warning');
                        }

                        state.items.push({
                            id: p.id,
                            codigo: p.codigo,
                            nombre: p.nombre,
                            precio: Number(p.precio),
                            stock: p.stock,
                            cantidad: cantFinal
                        });
                    }

                    guardarEstado();
                    renderCarrito();
            }

            // Buscar cliente
            async function buscarCliente() {
                const ci = $('ci').value.trim();

                if (!ci) {
                    aviso('Escribe un CI/NIT para buscar.', 'warning');
                    return;
                }

                try {
                    const r = await fetch(
                        URL_CLIENTE + '?ci=' + encodeURIComponent(ci)
                    );

                    if (!r.ok) throw new Error();

                    const d = await r.json();

                    if (d.encontrado) {
                        state.cliente = {
                            id: d.id,
                            ci: d.ci,
                            nombre: d.nombre
                        };

                        state.ci = ci;

                        guardarEstado();
                        renderCliente();

                    } else {
                        state.cliente = null;

                        guardarEstado();
                        renderCliente();

                        $('clienteInfo').innerHTML = `
                                    <span class="text-danger">
                                        No existe un cliente con ese CI/NIT.
                                    </span>
                                    Usa el botón Nuevo para registrarlo.`;
                    }

                } catch {
                    aviso('No se pudo buscar el cliente.');
                }
            }

            // Ventana de nuevo cliente (Bootstrap 4)
            let existenteTmp = null;

            function abrirModal() {
                $('mCi').value = $('ci').value.trim();
                $('mNombres').value = '';
                $('mApellidos').value = '';

                $('modalAviso').classList.add('d-none');
                $('btnUsarExistente').classList.add('d-none');

                existenteTmp = null;

                window.jQuery('#modalCliente').modal('show');
            }

            function seleccionarCliente(c) {
                state.cliente = {
                    id: c.id,
                    ci: c.ci,
                    nombre: c.nombre
                };

                state.ci = c.ci;

                $('ci').value = c.ci;

                guardarEstado();
                renderCliente();

                window.jQuery('#modalCliente').modal('hide');
            }
            // Guardar nuevo cliente
            async function guardarCliente() {
                const body = {
                    cedulaIdentidad: $('mCi').value.trim(),
                    nombres: $('mNombres').value.trim(),
                    apellidos: $('mApellidos').value.trim()
                };

                const av = $('modalAviso');
                const btn = $('btnGuardarCliente');

                if (!body.cedulaIdentidad || !body.nombres) {
                    av.textContent = 'CI/NIT y nombres son obligatorios.';
                    av.classList.remove('d-none');
                    return;
                }

                if (btn.disabled) return;
                btn.disabled = true;
                av.classList.add('d-none');
                $('btnUsarExistente').classList.add('d-none');
                existenteTmp = null;

                const token = document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

                try {
                    const r = await fetch(URL_NUEVO_CLIENTE, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token ? token.value : ''
                        },
                        body: JSON.stringify(body)
                    });

                    const d = await r.json().catch(() => null);

                    if (r.ok && d && d.ok) {
                        $('clienteInfo').innerHTML = '';
                        seleccionarCliente(d);
                        return;
                    }

                    if (d) {
                        av.textContent = d.mensaje || 'No se pudo registrar el cliente.';
                        av.classList.remove('d-none');

                        if (d.existe) {
                            existenteTmp = d;
                            $('btnUsarExistente').classList.remove('d-none');
                        }
                        return;
                    }

                    av.textContent = `No se pudo guardar el cliente (HTTP ${r.status}).`;
                    av.classList.remove('d-none');
                } catch {
                    av.textContent = 'No se pudo guardar el cliente.';
                    av.classList.remove('d-none');
                } finally {
                    btn.disabled = false;
                }
            }
            // Registrar la venta
            async function registrar() {
                const t = totales();

                if (!state.cliente) {
                    aviso('Selecciona un cliente.', 'warning');
                    return;
                }

                if (!state.items.length) {
                    aviso('Agrega productos a la venta.', 'warning');
                    return;
                }

                const rec = parseFloat(state.recibido);

                if (state.metodo === 'Efectivo' &&
                    (isNaN(rec) || rec < t.total)) {
                    aviso('El monto recibido debe cubrir el total.', 'warning');
                    return;
                }

                const btn = $('btnRegistrar');
                btn.disabled = true;

                const token = document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

                try {
                    const recibidoEnvio = state.metodo === 'Efectivo' ? rec : 0;

                    const r = await fetch(
                        URL_REGISTRAR + '?recibido=' + encodeURIComponent(recibidoEnvio),
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token ? token.value : ''
                            },
                            body: JSON.stringify({
                                idCliente: state.cliente.id,
                                metodoPago: state.metodo,
                                observaciones: state.obs,
                                ventaDetalle: state.items.map(i => ({
                                    idProducto: i.id,
                                    cantidad: i.cantidad
                                }))
                            })
                        }
                    );

                    if (!r.ok) throw new Error();

                    const d = await r.json();

                    if (d.ok) {
                        limpiarEstado();

                        window.location.href = URL_DETALLE + '?id=' + d.id;
                        return;
                    }

                    aviso(d.mensaje || 'No se pudo registrar la venta.');
                    refrescar();

                } catch {
                    aviso('No se pudo registrar la venta. Intenta nuevamente.');
                }

                btn.disabled = false;
            }

            // Cancelar la venta
            function cancelar() {
                if (state.items.length &&
                    !confirm('¿Deseas cancelar la venta y vaciar el carrito?')) {
                    return;
                }

                limpiarEstado();

                $('ci').value = '';
                $('obs').value = '';
                $('recibido').value = '';
                $('metodo').value = 'Efectivo';
                $('q').value = '';

                renderCliente();
                renderCarrito();
                cargarProductos();
            }

            // Eventos del carrito
            $('carrito').addEventListener('click', e => {
                const b = e.target.closest('button[data-act]');

                if (!b) return;

                const idx = Number(b.dataset.idx);
                const i = state.items[idx];

                if (!i) return;

                if (b.dataset.act === 'mas') {
                    if (i.cantidad >= i.stock) {
                        aviso('Stock máximo alcanzado.', 'warning');
                        return;
                    }

                    i.cantidad++;

                } else if (b.dataset.act === 'menos') {
                    if (i.cantidad > 1) {
                        i.cantidad--;
                    } else {
                        state.items.splice(idx, 1);
                    }

                } else if (b.dataset.act === 'del') {
                    state.items.splice(idx, 1);
                }

                guardarEstado();
                renderCarrito();
            });
            $('carrito').addEventListener('focusout', e => {
                const input = e.target.closest('input[data-act="set-cantidad"]');
                if (!input) return;

                const idx = Number(input.dataset.idx);
                const item = state.items[idx];
                if (!item) return;

                let cantidad = parseInt(input.value, 10);

                if (isNaN(cantidad) || cantidad < 1) {
                    cantidad = 1;
                }

                if (cantidad > item.stock) {
                    cantidad = item.stock;
                    aviso(`Stock insuficiente. Disponible: ${item.stock}.`, 'warning');
                }

                item.cantidad = cantidad;
                input.value = cantidad;

                guardarEstado();
                renderTotales();
            });
            $('carrito').addEventListener('keydown', e => {
                const input = e.target.closest('input[data-act="set-cantidad"]');
                if (!input) return;

                if (e.key === 'Enter') {
                    e.preventDefault();
                    input.blur();   
                }
            });
            // Eventos de productos
            let timerBusqueda;
            $('productos').addEventListener('click', e => {
                const b = e.target.closest('button[data-add]');

                if (b) {
                    agregar(JSON.parse(b.dataset.add));
                }
            });
            $('q').addEventListener('input', () => {
                clearTimeout(timerBusqueda);

                timerBusqueda = setTimeout(() => {
                    state.q = $('q').value;
                    guardarEstado();
                    cargarProductos();
                }, 300);
            });

            $('btnLimpiarBusqueda').addEventListener('click', () => {
                $('q').value = '';
                state.q = '';

                guardarEstado();
                cargarProductos();
            });

            // Eventos de clientes
            let timerCliente;
            $('ci').addEventListener('input', () => {
                state.ci = $('ci').value;
                if (state.cliente && $('ci').value.trim() !== state.cliente.ci) {
                    state.cliente = null;
                    renderCliente();
                }

                guardarEstado();

                clearTimeout(timerCliente);
                timerCliente = setTimeout(() => {
                    const ci = $('ci').value.trim();
                    if (ci.length >= 4) {
                        buscarCliente();
                    }
                }, 500);
            });

            $('btnNuevoCliente').addEventListener('click', abrirModal);
            $('btnGuardarCliente').addEventListener('click', guardarCliente);

            $('btnUsarExistente').addEventListener('click', () => {
                if (existenteTmp) {
                    seleccionarCliente(existenteTmp);
                }
            });

            // Eventos de pago
            $('metodo').addEventListener('change', () => {
                state.metodo = $('metodo').value;

                guardarEstado();
                renderTotales();
            });

            $('recibido').addEventListener('input', () => {
                state.recibido = $('recibido').value;

                guardarEstado();
                renderTotales();
            });

            $('obs').addEventListener('input', () => {
                state.obs = $('obs').value;
                guardarEstado();
            });

            // Registrar y cancelar
            $('btnRegistrar').addEventListener('click', registrar);
            $('btnCancelar').addEventListener('click', cancelar);

            // Recuperar los datos al abrir la página
            $('ci').value = state.ci || (state.cliente ? state.cliente.ci : '');
            $('obs').value = state.obs;
            $('metodo').value = state.metodo;
            $('recibido').value = state.recibido;
            $('q').value = state.q;

            renderCliente();
            renderCarrito();
            refrescar();

            // Actualizar los productos al regresar a la página
            window.addEventListener('pageshow', e => {
                if (e.persisted) refrescar();
            });

            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) refrescar();
            });

        })();
    </script>

    <style>

        .pv-header {
            background: #4682b4;
            color: white;
            border-radius: .5rem;
            padding: .9rem 1.25rem;
        }

        .pv-card {
            transition: box-shadow .15s;
        }

            .pv-card:hover {
                box-shadow: 0 .25rem .75rem rgba(0, 0, 0, .15);
            }

            .pv-card img {
                height: 140px;
                object-fit: cover;
                background: #e9ecef;
            }

        .pv-productos {
            max-height: 62vh;
            overflow-y: auto;
        }

        .pv-cart {
            max-height: 34vh;
            overflow-y: auto;
        }

        .pv-qty {
            display: inline-block;
            width: 2rem;
            text-align: center;
        }

        .pv-total {
            background: #0a2a6b;
            color: white;
            border-radius: .5rem;
            padding: .75rem 1rem;
            font-size: 1.3rem;
        }
    </style>

}
