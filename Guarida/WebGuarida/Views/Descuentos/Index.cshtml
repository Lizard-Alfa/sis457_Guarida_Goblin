@model IEnumerable<WebGuarida.Models.Descuento>

@{
    ViewData["Title"] = "Descuentos";
}

<h1>Descuentos</h1>

<p>
    <a asp-action="Create">Crear nuevo</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Nombre de la promocion</th>
            <th>Porcentage</th>
            <th>Fecha de inicio</th>
            <th>Fecha fin</th>
            <th>Descripción</th>
            <th>Usuario</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(model => item.Nombre) </td>
            <td>@Html.DisplayFor(model => item.Porcentaje)</td>
            <td>@Html.DisplayFor(model => item.FechaInicio)</td>
            <td>@Html.DisplayFor(model => item.FechaFin)</td>
            <td>@Html.DisplayFor(model => item.Descripcion)</td>
            <td>@Html.DisplayFor(model => item.UsuarioRegistro)</td>
                <td>
                    @switch ((Estado)item.Estado)
                    {
                        case Estado.Activo:
                            <span class="badge bg-success">Activo</span>
                            break;
                        case Estado.Inactivo:
                            <span class="badge bg-secondary">Inactivo</span>
                            break;
                    }
                </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
    </tbody>
</table>
<style>
    .badge {
        color: #000 !important;
    }
</style>
