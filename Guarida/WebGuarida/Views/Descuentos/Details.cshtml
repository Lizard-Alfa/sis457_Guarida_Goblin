@model WebGuarida.Models.Descuento

@{
    ViewData["Title"] = "Detalles de Descuento";
}

<h1>Detalles de Descuento</h1>

<div>
    <hr />
    <dl class="row">

        <dt class = "col-sm-2">Nombre del descuento</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Nombre)</dd>

        <dt class = "col-sm-2">Porcentaje(%)</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.Porcentaje)</dd>

        <dt class = "col-sm-2">Fecha de inicio</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.FechaInicio)</dd>

        <dt class = "col-sm-2">Fecha fin</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.FechaFin)</dd>

        <dt class = "col-sm-2">Descripción<dd class = "col-sm-10">@Html.DisplayFor(model => model.Descripcion)</dd>

        <dt class = "col-sm-2">Usuario</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.UsuarioRegistro)</dd>

        <dt class = "col-sm-2">fecha de Registro</dt>
        <dd class = "col-sm-10">@Html.DisplayFor(model => model.FechaRegistro)</dd>

            <dt class="col-sm-2">Estado</dt>
            <dd class="col-sm-10">
                @switch ((Estado)Model.Estado)
                {
                    case Estado.Activo:
                        <span class="badge bg-success">Activo</span>
                        break;
                    case Estado.Inactivo:
                        <span class="badge bg-secondary">Inactivo</span>
                        break;
                }
            </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>

    <style>
        .badge {
            color: #000 !important;
        }
    </style>
